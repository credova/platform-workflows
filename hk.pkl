amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

hooks {
  ["pre-commit"] {
    steps {
      ["shellcheck"] = Builtins.shellcheck
    }
  }
  ["pre-push"] {
    steps {
      // Lints every workflow when any workflow or the runner-label config changes.
      ["jactionlint"] {
        glob = List(".github/workflows/*.{yml,yaml}", ".github/jactionlint.yaml")
        check = "jactionlint" // profile comes from .github/jactionlint.yaml, same as CI
      }
    }
  }
}
