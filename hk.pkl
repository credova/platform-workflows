amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

hooks {
  ["pre-push"] {
    steps {
      // Lints every workflow when any workflow or the runner-label config changes.
      ["jactionlint"] {
        glob = List(".github/workflows/*.{yml,yaml}", ".github/jactionlint.yaml")
        check = "jactionlint --profile correctness" // 2.x defaults to a stricter profile; keep the actionlint-equivalent checks
      }
    }
  }
}
